# Copy to .ssl_server.env in the repository root. Never commit the local file.
SSL_DATA_ROOT=/absolute/path/to/datasets
SSL_MODEL_ROOT=/absolute/path/to/models
SSL_RUN_ROOT=/absolute/path/to/SSL_runs
# Optional canonical backup/synchronization target. May be local or user@host:/path.
SSL_RESULTS_MASTER=/absolute/path/or/user@host:/path/to/SSL_results_master
